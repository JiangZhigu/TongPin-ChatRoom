[Unit]
Description=Tongpin single-process chat service
After=network.target

[Service]
Type=simple
User=tongpin
Group=tongpin
WorkingDirectory=/srv/tongpin/controller
ExecStart=/srv/tongpin/controller/.venv/bin/python /srv/tongpin/controller/scripts/deploy.py --env-file /srv/tongpin/config/production.env run --state /srv/tongpin/control/active.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/tongpin/persistent
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

