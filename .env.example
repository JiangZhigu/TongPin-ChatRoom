# Development values only. Paths resolve from the project directory.
TONGPIN_ENV=development
TONGPIN_HOST=127.0.0.1
TONGPIN_PORT=8765
TONGPIN_DATA_DIR=var
TONGPIN_ORIGINS=http://127.0.0.1:8765,http://localhost:8765,http://127.0.0.1:5173,http://localhost:5173
# Production requires an operator-provided secret and exact HTTPS origins.
# TONGPIN_SECRET=
