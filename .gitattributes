# SQL migration checksums must remain identical on every checkout/platform.
*.sql text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Pinned Unicode hashes and generated emoji bytes must survive Windows checkout.
vendor/unicode/** text eol=lf
apps/web/src/data/emoji.json text eol=lf
src/tongpin/data/emoji.json text eol=lf
